<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, initial-scale=1">

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 1920px;
  height: 1080px;
  overflow: hidden;
  background: #0a0a0a;
  color: #fff;
  font-family: Arial, sans-serif;
}

.header {
  height: 110px;
  background: #111;
  border-bottom: 4px solid #7a3030;
  padding: 30px 120px 10px 120px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 38px;
  font-weight: 900;
  letter-spacing: 3px;
  white-space: nowrap;
}

.logo-sub {
  font-size: 18px;
  color: #777;
  font-weight: 400;
  letter-spacing: 1px;
}

.header-right {
  text-align: right;
  color: #aaa;
  font-size: 18px;
  line-height: 1.5;
  min-width: 360px;
  padding-left: 30px;
}

.live {
  color: #5cb85c;
}

.ticker {
  height: 48px;
  background: #7a3030;
  color: #f5dddd;
  font-size: 20px;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.ticker-inner {
  display: inline-block;
  padding-left: 100%;
  animation: scroll 150s linear infinite;
  -webkit-animation: scroll 150s linear infinite;
  will-change: transform;
}

@keyframes scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}

@-webkit-keyframes scroll {
  0% {
    -webkit-transform: translateX(0);
  }
  100% {
    -webkit-transform: translateX(-100%);
  }
}

.section-header {
  height: 65px;
  padding: 0 120px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #151515;
  border-bottom: 2px solid #7a3030;
}

.section-title {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 2px;
}

.updated {
  font-size: 15px;
  color: #777;
}

.column-header,
.game-row {
  display: grid;
  grid-template-columns: 650px 155px 155px 155px 155px;
  column-gap: 18px;
  align-items: center;
}

.column-header {
  height: 50px;
  padding: 0 120px;
  background: #111;
  color: #666;
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.column-header div:not(:first-child) {
  text-align: center;
}

#games {
  height: 708px;
  overflow: hidden;
}

.game-row {
  height: 118px;
  padding: 11px 120px;
  border-bottom: 1px solid #242424;
}

.game-row:nth-child(odd) {
  background: #0d0d0d;
}

.game-row:nth-child(even) {
  background: #151515;
}

.game-row.featured {
  border-left: 6px solid #a04040;
  padding-left: 114px;
  background: #181313;
}

.teams {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.team {
  font-size: 22px;
  font-weight: 800;
}

.away {
  color: #bbb;
  font-weight: 500;
}

.game-time {
  color: #d8b84a;
  font-size: 15px;
}

.feature-tag {
  display: inline-block;
  margin-left: 10px;
  padding: 2px 7px;
  background: #7a3030;
  color: #f0d0d0;
  font-size: 11px;
  vertical-align: middle;
}

.odds {
  text-align: center;
  font-size: 19px;
  font-weight: 800;
  color: #f0c040;
}

.odds div {
  margin: 3px auto;
  padding: 6px 8px;
  min-width: 100px;
  display: inline-block;
  background: #1b1b1b;
  border: 1px solid #303030;
  border-radius: 3px;
}

.status {
  text-align: center;
  font-size: 18px;
  font-weight: 800;
  color: #fff;
}

.loading,
.error,
.no-games {
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #777;
  font-size: 28px;
}

.footer {
  height: 99px;
  background: #0f0f0f;
  border-top: 1px solid #222;
  padding: 0 120px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #555;
  font-size: 14px;
}
</style>
</head>

<body>

<div class="header">

  <div class="logo">
    P.V. HOUSE
    <span class="logo-sub">
      — Restaurant &amp; Sports Lounge / Playa Vista
    </span>
  </div>

  <div class="header-right">
    <span class="live">●</span>
    LIVE NFL ODDS<br>
    <span id="dateDisplay"></span>
  </div>

</div>

<div class="ticker">
  <div class="ticker-inner" id="ticker">
    Loading today's NFL games...
  </div>
</div>

<div class="section-header">

  <div class="section-title">
    ● &nbsp; NFL — TODAY'S GAMES
  </div>

  <div>
    <span class="updated" id="pageIndicator"></span>
    <span class="updated">&nbsp;&nbsp; | &nbsp;&nbsp;</span>
    <span class="updated" id="updated"></span>
  </div>

</div>

<div class="column-header">
  <div>MATCHUP</div>
  <div>SPREAD</div>
  <div>MONEYLINE</div>
  <div>OVER / UNDER</div>
  <div>KICKOFF</div>
</div>

<div id="games">
  <div class="loading">
    Loading current NFL games...
  </div>
</div>

<div class="footer">

  <div>
    pvhousela.com &nbsp; • &nbsp;
    @p.v.house &nbsp; • &nbsp;
    Playa Vista
  </div>

  <div>
    Odds for entertainment only • Must be 21+ to wager
  </div>

</div>

<script>

const DATA_URL =
  "https://pv-house-sports.gian-ganziano.workers.dev/nfl";

const FEATURED_TEAMS = [
  "Los Angeles Rams",
  "Los Angeles Chargers"
];

const GAMES_PER_PAGE = 6;
const PAGE_DURATION = 12000;

let allGames = [];
let currentPage = 0;
let pageTimer = null;


/* ---------- DATE / TIME ---------- */

function formatDate(date) {

  return date.toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "America/Los_Angeles"
  }).toUpperCase();

}

function formatTime(iso) {

  return new Date(iso).toLocaleTimeString("en-US", {
    hour: "numeric",
    minute: "2-digit",
    timeZone: "America/Los_Angeles"
  }) + " PT";

}


/* ---------- ODDS HELPERS ---------- */

function getBookmaker(game) {

  if (!game.bookmakers || !game.bookmakers.length) {
    return null;
  }

  return (
    game.bookmakers.find(
      bookmaker => bookmaker.key === "draftkings"
    ) ||
    game.bookmakers[0]
  );

}

function getMarket(bookmaker, key) {

  if (!bookmaker) return null;

  return bookmaker.markets.find(
    market => market.key === key
  );

}

function findOutcome(market, team) {

  if (!market) return null;

  return market.outcomes.find(
    outcome => outcome.name === team
  );

}

function formatAmerican(value) {

  if (value === undefined || value === null) {
    return "—";
  }

  return value > 0
    ? "+" + value
    : String(value);

}


/* ---------- FEATURED TEAMS ---------- */

function isFeatured(game) {

  return FEATURED_TEAMS.some(team =>
    game.home_team.includes(team) ||
    game.away_team.includes(team)
  );

}


/* ---------- BUILD GAME ROW ---------- */

function createGameRow(game) {

  const bookmaker = getBookmaker(game);

  const spreadMarket =
    getMarket(bookmaker, "spreads");

  const moneyMarket =
    getMarket(bookmaker, "h2h");

  const totalMarket =
    getMarket(bookmaker, "totals");

  const awaySpread =
    findOutcome(spreadMarket, game.away_team);

  const homeSpread =
    findOutcome(spreadMarket, game.home_team);

  const awayMoney =
    findOutcome(moneyMarket, game.away_team);

  const homeMoney =
    findOutcome(moneyMarket, game.home_team);

  let total = "—";

  if (
    totalMarket &&
    totalMarket.outcomes &&
    totalMarket.outcomes.length
  ) {

    const over =
      totalMarket.outcomes.find(
        outcome => outcome.name === "Over"
      );

    if (
      over &&
      over.point !== undefined
    ) {

      total = "O " + over.point;

    }

  }

  const featured = isFeatured(game);

  return `

    <div class="game-row ${featured ? "featured" : ""}">

      <div class="teams">

        <div class="team away">

          ${game.away_team}

          ${featured
            ? '<span class="feature-tag">LA</span>'
            : ''
          }

        </div>

        <div class="team">
          @ ${game.home_team}
        </div>

        <div class="game-time">
          ${formatTime(game.commence_time)}
        </div>

      </div>

      <div class="odds">

        <div>
          ${
            awaySpread &&
            awaySpread.point !== undefined
              ? formatAmerican(awaySpread.point)
              : "—"
          }
        </div>

        <div>
          ${
            homeSpread &&
            homeSpread.point !== undefined
              ? formatAmerican(homeSpread.point)
              : "—"
          }
        </div>

      </div>

      <div class="odds">

        <div>
          ${
            awayMoney
              ? formatAmerican(awayMoney.price)
              : "—"
          }
        </div>

        <div>
          ${
            homeMoney
              ? formatAmerican(homeMoney.price)
              : "—"
          }
        </div>

      </div>

      <div class="odds">
        <div>${total}</div>
      </div>

      <div class="status">
        ${formatTime(game.commence_time)}
      </div>

    </div>

  `;

}


/* ---------- PAGINATION ---------- */

function displayPage() {

  if (!allGames.length) {
    return;
  }

  const gamesDiv =
    document.getElementById("games");

  const totalPages =
    Math.ceil(
      allGames.length / GAMES_PER_PAGE
    );

  if (currentPage >= totalPages) {
    currentPage = 0;
  }

  const start =
    currentPage * GAMES_PER_PAGE;

  const end =
    Math.min(
      start + GAMES_PER_PAGE,
      allGames.length
    );

  const pageGames =
    allGames.slice(start, end);

  gamesDiv.innerHTML =
    pageGames
      .map(createGameRow)
      .join("");

  document
    .getElementById("pageIndicator")
    .textContent =

      `GAMES ${start + 1}–${end} OF ${allGames.length}` +
      ` • PAGE ${currentPage + 1} OF ${totalPages}`;

  currentPage++;

  if (currentPage >= totalPages) {
    currentPage = 0;
  }

}


/* ---------- LOAD LIVE DATA ---------- */

async function loadGames() {

  const gamesDiv =
    document.getElementById("games");

  try {

    const response =
      await fetch(DATA_URL, {
        cache: "no-store"
      });

    if (!response.ok) {

      throw new Error(
        "Sports data unavailable"
      );

    }

    const games =
      await response.json();

    if (
      !Array.isArray(games) ||
      !games.length
    ) {

      gamesDiv.innerHTML =
        '<div class="no-games">' +
        'No current NFL games available.' +
        '</div>';

      return;

    }


    /* Chronological order */

    games.sort(
      (a, b) =>
        new Date(a.commence_time) -
        new Date(b.commence_time)
    );


    /*
      Move Rams / Chargers games to Page 1.
    */

    games.sort(
      (a, b) =>
        Number(isFeatured(b)) -
        Number(isFeatured(a))
    );


    allGames = games;

    currentPage = 0;

    displayPage();


    if (pageTimer) {
      clearInterval(pageTimer);
    }


    if (
      allGames.length >
      GAMES_PER_PAGE
    ) {

      pageTimer =
        setInterval(
          displayPage,
          PAGE_DURATION
        );

    }


    /* ---------- TICKER ---------- */

    document
      .getElementById("ticker")
      .innerHTML =

        games
          .map(game =>
            `${game.away_team} @ ${game.home_team}` +
            ` — ${formatTime(game.commence_time)}`
          )
          .join(
            " &nbsp; • &nbsp; "
          );


    /* ---------- UPDATED TIME ---------- */

    document
      .getElementById("updated")
      .textContent =

        "UPDATED " +

        new Date()
          .toLocaleTimeString(
            "en-US",
            {
              hour: "numeric",
              minute: "2-digit",
              timeZone:
                "America/Los_Angeles"
            }
          )

        + " PT";


  } catch (error) {

    console.error(error);

    gamesDiv.innerHTML =
      '<div class="error">' +
      'Unable to load NFL data.' +
      '</div>';

  }

}


/* ---------- START ---------- */

document
  .getElementById("dateDisplay")
  .textContent =
    formatDate(new Date());

loadGames();

/*
  Refresh sports data every five minutes.
*/
setInterval(
  loadGames,
  5 * 60 * 1000
);

</script>

</body>
</html>
